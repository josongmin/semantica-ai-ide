{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom/vitest"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "~shared/*": [
        "src/shared/*"
      ],
      "~entities/*": [
        "src/shared/entities/*"
      ],
      "~features/*": [
        "src/features/*"
      ],
      "~widgets/*": [
        "src/widgets/*"
      ],
      "~pages/*": [
        "src/pages/*"
      ],
      "~app/*": [
        "src/app/*"
      ],
      "~surfaces/*": [
        "src/surfaces/*"
      ],
      "~domains/*": [
        "src/domains/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
